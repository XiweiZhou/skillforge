        {
          "field": "context.has_timezone",
          "operator": "equals",
          "value": false
        }
      ],
      "actions": [
        {
          "action_type": "add_field",
          "target": "context.timezone",
          "value": "UTC"
        },
        {
          "action_type": "flag",
          "target": "_flags",
          "value": "timezone_added"
        }
      ],
      "source_error_type": "TimezoneError",
