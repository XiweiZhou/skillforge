  "email_writer": [
    {
      "id": "rule_timezoneerror_1",
      "name": "Prevent Timezone",
      "rule_type": "prevention",
      "conditions": [
        {
          "field": "task.description",
          "operator": "matches",
          "value": "\\d{1,2}\\s*(am|pm|AM|PM)"
