{
  "email_writer": [
    {
      "id": "rule_timezoneerror_1",
      "name": "Prevent Timezone",
      "rule_type": "prevention",
      "conditions": [
        {
          "field": "task.description",
          "operator": "matches",
          "value": "\\d{1,2}\\s*(am|pm|AM|PM)"
        },
        {
          "field": "context.has_timezone",
          "operator": "equals",
          "value": false
        }
      ],
      "actions": [
        {
          "action_type": "add_field",
          "target": "context.timezone",
          "value": "UTC"
        },
        {
          "action_type": "flag",
          "target": "_flags",
          "value": "timezone_added"
        }
      ],
      "source_error_type": "TimezoneError",
      "confidence": 0.4117647058823529,
      "times_applied": 0,
      "times_successful": 0,
      "created_at": "2026-02-07T23:32:14.898883",
      "last_applied": null,
      "description": "Add timezone when time is mentioned without one"
    },
    {
      "id": "rule_spamtriggererror_2",
      "name": "Prevent SpamTrigger",
      "rule_type": "prevention",
      "conditions": [
        {
